   562                                  ; ----------------------------------------------------------------------------
   563                                  ; ROTINA: line
   564                                  ; Descrição: Desenha uma reta entre (x1, y1) e (x2, y2) utilizando
   565                                  ;            uma variação do algoritmo de Bresenham.
   566                                  ; Parâmetros via Pilha:
   567                                  ;   [bp+10] -> x1
   568                                  ;   [bp+8]  -> y1
   569                                  ;   [bp+6]  -> x2
   570                                  ;   [bp+4]  -> y2
   571                                  ; ----------------------------------------------------------------------------
   572                                  line:
   573 00000282 55                          push    bp
   574 00000283 89E5                        mov     bp, sp
   575 00000285 9C                          pushf
   576 00000286 50                          push    ax
   577 00000287 53                          push    bx
   578 00000288 51                          push    cx
   579 00000289 52                          push    dx
   580 0000028A 56                          push    si
   581 0000028B 57                          push    di
   582                                  
   583 0000028C 8B460A                      mov     ax, [bp+10]         ; AX = x1
   584 0000028F 8B5E08                      mov     bx, [bp+8]          ; BX = y1
   585 00000292 8B4E06                      mov     cx, [bp+6]          ; CX = x2
   586 00000295 8B5604                      mov     dx, [bp+4]          ; DX = y2
   587                                  
   588 00000298 39C8                        cmp     ax, cx
   589 0000029A 7408                        je      line2               ; DeltaX == 0 (Linha estritamente vertical)
   590 0000029C 721C                        jb      line1               ; Se x1 < x2, mantém ordem
   591 0000029E 91                          xchg    ax, cx              ; Se x1 > x2, troca os pontos para desenhar da esquerda p/ direita
   592 0000029F 87DA                        xchg    bx, dx
   593 000002A1 E91600                      jmp     line1
   594                                  
   595                                  line2:                          ; Trata linhas verticais (DeltaX = 0)
   596 000002A4 39D3                        cmp     bx, dx
   597 000002A6 7202                        jb      line3
   598 000002A8 87DA                        xchg    bx, dx              ; Garante y1 < y2
   599                                  
   600                                  line3:                          ; Loop de desenho da linha vertical
   601 000002AA 50                          push    ax
   602 000002AB 53                          push    bx
   603 000002AC E814FE                      call    plot_xy
   604 000002AF 39D3                        cmp     bx, dx
   605 000002B1 7503                        jne     line31
   606 000002B3 E9C600                      jmp     fim_line
   607                                  line31:
   608 000002B6 43                          inc     bx
   609 000002B7 E9F0FF                      jmp     line3
   610                                  
   611                                  line1:                          ; Calcula deltax e deltay quando deltax != 0
   612 000002BA 51                          push    cx
   613 000002BB 29C1                        sub     cx, ax
   614 000002BD 890E[0600]                  mov     [deltax], cx
   615 000002C1 59                          pop     cx
   616                                  
   617 000002C2 52                          push    dx
   618 000002C3 29DA                        sub     dx, bx
   619 000002C5 7702                        ja      line32
   620 000002C7 F7DA                        neg     dx                  ; dx = |y2 - y1|
   621                                  line32:
   622 000002C9 8916[0800]                  mov     [deltay], dx
   623 000002CD 5A                          pop     dx
   624                                  
   625 000002CE 50                          push    ax
   626 000002CF A1[0600]                    mov     ax, [deltax]
   627 000002D2 3B06[0800]                  cmp     ax, [deltay]
   628 000002D6 58                          pop     ax
   629 000002D7 724D                        jb      line5               ; Se DeltaY > DeltaX, inclinação alta (passo em Y)
   630                                  
   631                                      ; --- Caso 1: Varredura principal em X (DeltaX >= DeltaY) ---
   632 000002D9 51                          push    cx
   633 000002DA 29C1                        sub     cx, ax
   634 000002DC 890E[0600]                  mov     [deltax], cx
   635 000002E0 59                          pop     cx
   636                                  
   637 000002E1 52                          push    dx
   638 000002E2 29DA                        sub     dx, bx
   639 000002E4 8916[0800]                  mov     [deltay], dx
   640 000002E8 5A                          pop     dx
   641                                  
   642 000002E9 89C6                        mov     si, ax              ; SI = x atual
   643                                  
   644                                  line4:
   645 000002EB 50                          push    ax
   646 000002EC 52                          push    dx
   647 000002ED 56                          push    si
   648 000002EE 29C6                        sub     si, ax              ; dx_atual = (x - x1)
   649 000002F0 A1[0800]                    mov     ax, [deltay]
   650 000002F3 F7EE                        imul    si                  ; AX = (x - x1) * deltay
   651 000002F5 8B36[0600]                  mov     si, [deltax]        ; Fator de arredondamento: deltax / 2
   652 000002F9 D1EE                        shr     si, 1
   653                                  
   654 000002FB 81FA0000                    cmp     dx, 0               ; Ajusta arredondamento baseado no sinal do produto
   655 000002FF 7C09                        jl      ar1
   656 00000301 01F0                        add     ax, si
   657 00000303 81D20000                    adc     dx, 0
   658 00000307 E90600                      jmp     arc1
   659                                  ar1:
   660 0000030A 29F0                        sub     ax, si
   661 0000030C 81DA0000                    sbb     dx, 0
   662                                  arc1:
   663 00000310 F73E[0600]                  idiv    word [deltax]       ; Y_calculado = ((x - x1) * deltay) / deltax
   664 00000314 01D8                        add     ax, bx              ; Y_final = y1 + Y_calculado
   665 00000316 5E                          pop     si
   666                                  
   667 00000317 56                          push    si                  ; X
   668 00000318 50                          push    ax                  ; Y
   669 00000319 E8A7FD                      call    plot_xy
   670                                  
   671 0000031C 5A                          pop     dx
   672 0000031D 58                          pop     ax
   673 0000031E 39CE                        cmp     si, cx
   674 00000320 745A                        je      fim_line
   675 00000322 46                          inc     si
   676 00000323 E9C5FF                      jmp     line4
   677                                  
   678                                      ; --- Caso 2: Varredura principal em Y (DeltaY > DeltaX) ---
   679                                  line5:
   680 00000326 39D3                        cmp     bx, dx
   681 00000328 7203                        jb      line7
   682 0000032A 91                          xchg    ax, cx
   683 0000032B 87DA                        xchg    bx, dx
   684                                  
   685                                  line7:
   686 0000032D 51                          push    cx
   687 0000032E 29C1                        sub     cx, ax
   688 00000330 890E[0600]                  mov     [deltax], cx
   689 00000334 59                          pop     cx
   690                                  
   691 00000335 52                          push    dx
   692 00000336 29DA                        sub     dx, bx
   693 00000338 8916[0800]                  mov     [deltay], dx
   694 0000033C 5A                          pop     dx
   695                                  
   696 0000033D 89DE                        mov     si, bx              ; SI = y atual
   697                                  
   698                                  line6:
   699 0000033F 52                          push    dx
   700 00000340 56                          push    si
   701 00000341 50                          push    ax
   702 00000342 29DE                        sub     si, bx              ; dy_atual = (y - y1)
   703 00000344 A1[0600]                    mov     ax, [deltax]
   704 00000347 F7EE                        imul    si                  ; AX = (y - y1) * deltax
   705 00000349 8B36[0800]                  mov     si, [deltay]        ; Fator de arredondamento
   706 0000034D D1EE                        shr     si, 1
   707                                  
   708 0000034F 81FA0000                    cmp     dx, 0
   709 00000353 7C09                        jl      ar2
   710 00000355 01F0                        add     ax, si
   711 00000357 81D20000                    adc     dx, 0
   712 0000035B E90600                      jmp     arc2
   713                                  ar2:
   714 0000035E 29F0                        sub     ax, si
   715 00000360 81DA0000                    sbb     dx, 0
   716                                  arc2:
   717 00000364 F73E[0800]                  idiv    word [deltay]       ; X_calculado = ((y - y1) * deltax) / deltay
   718 00000368 89C7                        mov     di, ax
   719 0000036A 58                          pop     ax
   720 0000036B 01C7                        add     di, ax              ; X_final = x1 + X_calculado
   721 0000036D 5E                          pop     si
   722                                  
   723 0000036E 57                          push    di                  ; X
   724 0000036F 56                          push    si                  ; Y
   725 00000370 E850FD                      call    plot_xy
   726                                  
   727 00000373 5A                          pop     dx
   728 00000374 39D6                        cmp     si, dx
   729 00000376 7404                        je      fim_line
   730 00000378 46                          inc     si
   731 00000379 E9C3FF                      jmp     line6
   732                                  
   733                                  fim_line:
   734 0000037C 5F                          pop     di
   735 0000037D 5E                          pop     si
   736 0000037E 5A                          pop     dx
   737 0000037F 59                          pop     cx
   738 00000380 5B                          pop     bx
   739 00000381 58                          pop     ax
   740 00000382 9D                          popf
   741 00000383 5D                          pop     bp
   742 00000384 C20800                      ret     8                   ; Limpa 8 bytes da pilha
