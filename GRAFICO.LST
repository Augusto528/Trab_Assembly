   176                                  ; ----------------------------------------------------------------------------
   177                                  ; ROTINA: cursor
   178                                  ; Descrição: Define a posição do cursor de texto na tela.
   179                                  ; Entradas: DH = Linha (0-29), DL = Coluna (0-79)
   180                                  ; ----------------------------------------------------------------------------
   181                                  cursor:
   182 0000008E 9C                          pushf
   183 0000008F 50                          push    ax
   184 00000090 53                          push    bx
   185 00000091 51                          push    cx
   186 00000092 52                          push    dx
   187 00000093 56                          push    si
   188 00000094 57                          push    di
   189 00000095 55                          push    bp
   190                                  
   191 00000096 B402                        mov     ah, 2               ; Interrupção para definir a posição do cursor
   192 00000098 B700                        mov     bh, 0               ; Página de vídeo 0
   193 0000009A CD10                        int     10h
   194                                  
   195 0000009C 5D                          pop     bp
   196 0000009D 5F                          pop     di
   197 0000009E 5E                          pop     si
   198 0000009F 5A                          pop     dx
   199 000000A0 59                          pop     cx
   200 000000A1 5B                          pop     bx
   201 000000A2 58                          pop     ax
   202 000000A3 9D                          popf
   203 000000A4 C3                          ret
   204                                  
   205                                  ; ----------------------------------------------------------------------------
   206                                  ; ROTINA: caracter
   207                                  ; Descrição: Imprime um caractere no local atual do cursor com cor personalizada.
   208                                  ; Entradas: AL = Caractere ASCII, Variavel 'cor' = Cor do caractere
   209                                  ; ----------------------------------------------------------------------------
   210                                  caracter:
   211 000000A5 9C                          pushf
   212 000000A6 50                          push    ax
   213 000000A7 53                          push    bx
   214 000000A8 51                          push    cx
   215 000000A9 52                          push    dx
   216 000000AA 56                          push    si
   217 000000AB 57                          push    di
   218 000000AC 55                          push    bp
   219                                  
   220 000000AD B409                        mov     ah, 9               ; Interrupção para escrever caracter
   221 000000AF B700                        mov     bh, 0               ; Página de vídeo   0
   222 000000B1 B90100                      mov     cx, 1               ; Quantidade de repetições do caractere
   223 000000B4 8A1E[0000]                  mov     bl, [cor]           ; Atributo de cor
   224 000000B8 CD10                        int     10h
   225                                  
   226 000000BA 5D                          pop     bp
   227 000000BB 5F                          pop     di
   228 000000BC 5E                          pop     si
   229 000000BD 5A                          pop     dx
   230 000000BE 59                          pop     cx
   231 000000BF 5B                          pop     bx
   232 000000C0 58                          pop     ax
   233 000000C1 9D                          popf
   234 000000C2 C3                          ret
   235                                  
   236                                  ; ----------------------------------------------------------------------------
   237                                  ; ROTINA: plot_xy
   238                                  ; Descrição: Desenha um ponto (pixel) na tela nas coordenadas (X, Y).
   239                                  ; Parâmetros via Pilha:
   240                                  ;   [bp+6] -> Coordenada X (0-639)
   241                                  ;   [bp+4] -> Coordenada Y (0-479)
   242                                  ; Entrada implícita: Variável 'cor'
   243                                  ; ----------------------------------------------------------------------------
   244                                  plot_xy:
   245 000000C3 55                          push    bp
   246 000000C4 89E5                        mov     bp, sp
   247 000000C6 9C                          pushf
   248 000000C7 50                          push    ax
   249 000000C8 53                          push    bx
   250 000000C9 51                          push    cx
   251 000000CA 52                          push    dx
   252 000000CB 56                          push    si
   253 000000CC 57                          push    di
   254                                  
   255 000000CD B40C                        mov     ah, 0ch             ; Interrupção para desenhar um pixel 
   256 000000CF A0[0000]                    mov     al, [cor]           ; Cor do pixel
   257 000000D2 B700                        mov     bh, 0               ; Página de vídeo 0
   258 000000D4 8B4E06                      mov     cx, [bp+6]          ; Coordenada X
   259 000000D7 8B5604                      mov     dx, [bp+4]          ; Coordenada Y (BIOS usa DX para Y)
   260 000000DA CD10                        int     10h
   261                                  
   262 000000DC 5F                          pop     di
   263 000000DD 5E                          pop     si
   264 000000DE 5A                          pop     dx
   265 000000DF 59                          pop     cx
   266 000000E0 5B                          pop     bx
   267 000000E1 58                          pop     ax
   268 000000E2 9D                          popf
   269 000000E3 5D                          pop     bp
   270 000000E4 C20400                      ret     4                   ; Limpa 4 bytes de parâmetros da pilha
   271                                  
   272                                  ; ----------------------------------------------------------------------------
   273                                  ; ROTINA: circle
   274                                  ; Descrição: Desenha o contorno de um círculo usando o algoritmo do Ponto Médio.
   275                                  ; Parâmetros via Pilha:
   276                                  ;   [bp+8] -> Coordenada X do centro (xc)
   277                                  ;   [bp+6] -> Coordenada Y do centro (yc)
   278                                  ;   [bp+4] -> Raio (r)
   279                                  ; ----------------------------------------------------------------------------
   280                                  circle:
   281 000000E7 55                          push    bp
   282 000000E8 89E5                        mov     bp, sp
   283 000000EA 9C                          pushf
   284 000000EB 50                          push    ax
   285 000000EC 53                          push    bx
   286 000000ED 51                          push    cx
   287 000000EE 52                          push    dx
   288 000000EF 56                          push    si
   289 000000F0 57                          push    di
   290                                  
   291 000000F1 8B4608                      mov     ax, [bp+8]          ; AX = xc
   292 000000F4 8B5E06                      mov     bx, [bp+6]          ; BX = yc
   293 000000F7 8B4E04                      mov     cx, [bp+4]          ; CX = r
   294                                  
   295                                      ; Plotagem dos 4 pontos cardeais extremos do círculo
   296 000000FA 89DA                        mov     dx, bx
   297 000000FC 01CA                        add     dx, cx              ; Topo: (xc, yc + r)
   298 000000FE 50                          push    ax
   299 000000FF 52                          push    dx
   300 00000100 E8C0FF                      call    plot_xy
   301                                  
   302 00000103 89DA                        mov     dx, bx
   303 00000105 29CA                        sub     dx, cx              ; Base: (xc, yc - r)
   304 00000107 50                          push    ax
   305 00000108 52                          push    dx
   306 00000109 E8B7FF                      call    plot_xy
   307                                  
   308 0000010C 89C2                        mov     dx, ax
   309 0000010E 01CA                        add     dx, cx              ; Direita: (xc + r, yc)
   310 00000110 52                          push    dx
   311 00000111 53                          push    bx
   312 00000112 E8AEFF                      call    plot_xy
   313                                  
   314 00000115 89C2                        mov     dx, ax
   315 00000117 29CA                        sub     dx, cx              ; Esquerda: (xc - r, yc)
   316 00000119 52                          push    dx
   317 0000011A 53                          push    bx
   318 0000011B E8A5FF                      call    plot_xy
   319                                  
   320                                      ; Variáveis de decisão do algoritmo do Ponto Médio
   321 0000011E 89CF                        mov     di, cx
   322 00000120 81EF0100                    sub     di, 1               ; di = d = r - 1 (variável de decisão)
   323 00000124 BA0000                      mov     dx, 0               ; DX = x = 0. CX já é a variável y = r
   324                                  
   325                                  stay:
   326 00000127 89FE                        mov     si, di
   327 00000129 81FE0000                    cmp     si, 0
   328 0000012D 7F0E                        jg      inf                 ; Se d > 0, decrementa Y (ponto inferior)
   329                                  
   330                                      ; Atualização de 'd' para o passo horizontal (E)
   331 0000012F 89D6                        mov     si, dx
   332 00000131 D1E6                        sal     si, 1               ; 2 * x
   333 00000133 81C60300                    add     si, 3               ; 2 * x + 3
   334 00000137 01F7                        add     di, si              ; d = d + 2*x + 3
   335 00000139 42                          inc     dx                  ; x++
   336 0000013A E90E00                      jmp     plotar
   337                                  
   338                                  inf:
   339                                      ; Atualização de 'd' para o passo diagonal (SE)
   340 0000013D 89D6                        mov     si, dx
   341 0000013F 29CE                        sub     si, cx              ; x - y
   342 00000141 D1E6                        sal     si, 1               ; 2 * (x - y)
   343 00000143 81C60500                    add     si, 5               ; 2 * (x - y) + 5
   344 00000147 01F7                        add     di, si              ; d = d + 2*(x - y) + 5
   345 00000149 42                          inc     dx                  ; x++
   346 0000014A 49                          dec     cx                  ; y--
   347                                  
   348                                  plotar:
   349                                      ; Plotagem simétrica nos 8 octantes:
   350 0000014B 89D6                        mov     si, dx
   351 0000014D 01C6                        add     si, ax
   352 0000014F 56                          push    si                  ; xc + x
   353 00000150 89CE                        mov     si, cx
   354 00000152 01DE                        add     si, bx
   355 00000154 56                          push    si                  ; yc + y
   356 00000155 E86BFF                      call    plot_xy             ; Octante 2
   357                                  
   358 00000158 89C6                        mov     si, ax
   359 0000015A 01D6                        add     si, dx
   360 0000015C 56                          push    si                  ; xc + x
   361 0000015D 89DE                        mov     si, bx
   362 0000015F 29CE                        sub     si, cx
   363 00000161 56                          push    si                  ; yc - y
   364 00000162 E85EFF                      call    plot_xy             ; Octante 7
   365                                  
   366 00000165 89C6                        mov     si, ax
   367 00000167 01CE                        add     si, cx
   368 00000169 56                          push    si                  ; xc + y
   369 0000016A 89DE                        mov     si, bx
   370 0000016C 01D6                        add     si, dx
   371 0000016E 56                          push    si                  ; yc + x
   372 0000016F E851FF                      call    plot_xy             ; Octante 1
   373                                  
   374 00000172 89C6                        mov     si, ax
   375 00000174 01CE                        add     si, cx
   376 00000176 56                          push    si                  ; xc + y
   377 00000177 89DE                        mov     si, bx
   378 00000179 29D6                        sub     si, dx
   379 0000017B 56                          push    si                  ; yc - x
   380 0000017C E844FF                      call    plot_xy             ; Octante 8
   381                                  
   382 0000017F 89C6                        mov     si, ax
   383 00000181 29D6                        sub     si, dx
   384 00000183 56                          push    si                  ; xc - x
   385 00000184 89DE                        mov     si, bx
   386 00000186 01CE                        add     si, cx
   387 00000188 56                          push    si                  ; yc + y
   388 00000189 E837FF                      call    plot_xy             ; Octante 3
   389                                  
   390 0000018C 89C6                        mov     si, ax
   391 0000018E 29D6                        sub     si, dx
   392 00000190 56                          push    si                  ; xc - x
   393 00000191 89DE                        mov     si, bx
   394 00000193 29CE                        sub     si, cx
   395 00000195 56                          push    si                  ; yc - y
   396 00000196 E82AFF                      call    plot_xy             ; Octante 6
   397                                  
   398 00000199 89C6                        mov     si, ax
   399 0000019B 29CE                        sub     si, cx
   400 0000019D 56                          push    si                  ; xc - y
   401 0000019E 89DE                        mov     si, bx
   402 000001A0 29D6                        sub     si, dx
   403 000001A2 56                          push    si                  ; yc - x
   404 000001A3 E81DFF                      call    plot_xy             ; Octante 5
   405                                  
   406 000001A6 89C6                        mov     si, ax
   407 000001A8 29CE                        sub     si, cx
   408 000001AA 56                          push    si                  ; xc - y
   409 000001AB 89DE                        mov     si, bx
   410 000001AD 01D6                        add     si, dx
   411 000001AF 56                          push    si                  ; yc + x
   412 000001B0 E810FF                      call    plot_xy             ; Octante 4
   413                                  
   414 000001B3 39D1                        cmp     cx, dx              ; Enquanto y >= x continua no loop
   415 000001B5 7203                        jb      fim_circle
   416 000001B7 E96DFF                      jmp     stay
   417                                  
   418                                  fim_circle:
   419 000001BA 5F                          pop     di
   420 000001BB 5E                          pop     si
   421 000001BC 5A                          pop     dx
   422 000001BD 59                          pop     cx
   423 000001BE 5B                          pop     bx
   424 000001BF 58                          pop     ax
   425 000001C0 9D                          popf
   426 000001C1 5D                          pop     bp
   427 000001C2 C20600                      ret     6                   ; Limpa 6 bytes da pilha
   428                                  
   429                                  ; ----------------------------------------------------------------------------
   430                                  ; ROTINA: full_circle
   431                                  ; Descrição: Desenha um círculo preenchido traçando linhas verticais
   432                                  ;            entre os pontos simétricos da circunferência.
   433                                  ; Parâmetros via Pilha:
   434                                  ;   [bp+8] -> Coordenada X do centro (xc)
   435                                  ;   [bp+6] -> Coordenada Y do centro (yc)
   436                                  ;   [bp+4] -> Raio (r)
   437                                  ; ----------------------------------------------------------------------------
   438                                  full_circle:
   439 000001C5 55                          push    bp
   440 000001C6 89E5                        mov     bp, sp
   441 000001C8 9C                          pushf
   442 000001C9 50                          push    ax
   443 000001CA 53                          push    bx
   444 000001CB 51                          push    cx
   445 000001CC 52                          push    dx
   446 000001CD 56                          push    si
   447 000001CE 57                          push    di
   448                                  
   449 000001CF 8B4608                      mov     ax, [bp+8]          ; AX = xc
   450 000001D2 8B5E06                      mov     bx, [bp+6]          ; BX = yc
   451 000001D5 8B4E04                      mov     cx, [bp+4]          ; CX = r
   452                                  
   453                                      ; Linha vertical central: de (xc, yc - r) até (xc, yc + r)
   454 000001D8 89DE                        mov     si, bx
   455 000001DA 29CE                        sub     si, cx
   456 000001DC 50                          push    ax
   457 000001DD 56                          push    si                  ; (xc, yc - r)
   458 000001DE 89DE                        mov     si, bx
   459 000001E0 01CE                        add     si, cx
   460 000001E2 50                          push    ax
   461 000001E3 56                          push    si                  ; (xc, yc + r)
   462 000001E4 E89B00                      call    line
   463                                  
   464 000001E7 89CF                        mov     di, cx
   465 000001E9 81EF0100                    sub     di, 1               ; di = r - 1
   466 000001ED BA0000                      mov     dx, 0               ; x = 0, y = r
   467                                  
   468                                  stay_full:
   469 000001F0 89FE                        mov     si, di
   470 000001F2 81FE0000                    cmp     si, 0
   471 000001F6 7F0E                        jg      inf_full
   472                                  
   473 000001F8 89D6                        mov     si, dx
   474 000001FA D1E6                        sal     si, 1
   475 000001FC 81C60300                    add     si, 3
   476 00000200 01F7                        add     di, si
   477 00000202 42                          inc     dx
   478 00000203 E90E00                      jmp     plotar_full
   479                                  
   480                                  inf_full:
   481 00000206 89D6                        mov     si, dx
   482 00000208 29CE                        sub     si, cx
   483 0000020A D1E6                        sal     si, 1
   484 0000020C 81C60500                    add     si, 5
   485 00000210 01F7                        add     di, si
   486 00000212 42                          inc     dx
   487 00000213 49                          dec     cx
   488                                  
   489                                  plotar_full:
   490                                      ; Traça linhas verticais conectando os pontos simétricos dos octantes
   491 00000214 89C6                        mov     si, ax
   492 00000216 01CE                        add     si, cx
   493 00000218 56                          push    si
   494 00000219 89DE                        mov     si, bx
   495 0000021B 29D6                        sub     si, dx
   496 0000021D 56                          push    si
   497 0000021E 89C6                        mov     si, ax
   498 00000220 01CE                        add     si, cx
   499 00000222 56                          push    si
   500 00000223 89DE                        mov     si, bx
   501 00000225 01D6                        add     si, dx
   502 00000227 56                          push    si
   503 00000228 E85700                      call    line
   504                                  
   505 0000022B 89C6                        mov     si, ax
   506 0000022D 01D6                        add     si, dx
   507 0000022F 56                          push    si
   508 00000230 89DE                        mov     si, bx
   509 00000232 29CE                        sub     si, cx
   510 00000234 56                          push    si
   511 00000235 89C6                        mov     si, ax
   512 00000237 01D6                        add     si, dx
   513 00000239 56                          push    si
   514 0000023A 89DE                        mov     si, bx
   515 0000023C 01CE                        add     si, cx
   516 0000023E 56                          push    si
   517 0000023F E84000                      call    line
   518                                  
   519 00000242 89C6                        mov     si, ax
   520 00000244 29D6                        sub     si, dx
   521 00000246 56                          push    si
   522 00000247 89DE                        mov     si, bx
   523 00000249 29CE                        sub     si, cx
   524 0000024B 56                          push    si
   525 0000024C 89C6                        mov     si, ax
   526 0000024E 29D6                        sub     si, dx
