   580                                  
   581                                      .loop_linhas_arq:
   582 0000032F B43F                            mov     ah, 3fh
   583 00000331 8B1E[4700]                      mov     bx, [file_handle]
   584 00000335 B9E001                          mov     cx, 480                 ; 480 bytes por linha
   585 00000338 BA[4900]                        mov     dx, buffer_linha
   586 0000033B CD21                            int     21h
   587                                  
   588 0000033D 3D0000                          cmp     ax, 0                   ; Se AX = 0, chegou ao Fim do Arquivo (EOF)
   589 00000340 743F                            je      .fechar_arq
   590                                  
   591 00000342 8B0E[2902]                      mov     cx, [x_inicial]         ; CX começa na coluna X inicial
