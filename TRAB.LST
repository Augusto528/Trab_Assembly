    44                                      ; Função que vai loopar enquanto o programa roda
    45                                      mouse:
    46                                          
    47                                          ; Usa pra ver as características do mouse de posição e pressionamento de botões
    48 0000003B B80300                          mov     ax, 3
    49 0000003E CD33                            int     33h
    50                                  
    51                                          ; Caso o botao esquerdo seja pressionado, bl = 00000001b, entao o test ve se isso é verdade. Se nao for, bl AND 00000001b = 0 e o jz vai fazer a funcao voltar pro mouse, loopando ate ter algum botao apertad
    52 00000040 F6C301                          test    bl, 00000001b
    53 00000043 74F6                            jz      mouse
    54                                  
