   677 0000039F B700                            mov     bh, 0               ; Página de vídeo 0
   678 000003A1 CD10                            int     10h
   679                                  
   680 000003A3 5D                              pop     bp
   681 000003A4 5F                              pop     di
   682 000003A5 5E                              pop     si
