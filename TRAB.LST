   598 0000034D 7618                            jbe     .avancar_ponteiro
   599                                  
   600                                          ; Conversão ASCII para cor (0 a 15)
   601 0000034F 3C39                            cmp     al, '9'
   602 00000351 7605                            jbe     .numero
   603 00000353 2C37                            sub     al, 55                  ; Se for letra ('A'-'F'), converte para 10-15
   604 00000355 E90200                          jmp     .pintar
   605                                  
   606                                      .numero:
   607 00000358 2C30                            sub     al, 48                  ; Se for número ('0'-'9'), converte para 0-9
   608                                  
