   914                                      ; ----------------------------------------------------------------------------
   915                                      ; ROTINA: full_circle
   916                                      ; Descrição: Desenha um círculo preenchido traçando linhas verticais
   917                                      ;            entre os pontos simétricos da circunferência.
   918                                      ; Parâmetros via Pilha:
   919                                      ;   [bp+8] -> Coordenada X do centro (xc)
   920                                      ;   [bp+6] -> Coordenada Y do centro (yc)
   921                                      ;   [bp+4] -> Raio (r)
   922                                      ; ----------------------------------------------------------------------------
   923                                      full_circle:
   924 000004CC 55                              push    bp
   925 000004CD 89E5                            mov     bp, sp
   926 000004CF 9C                              pushf
   927 000004D0 50                              push    ax
   928 000004D1 53                              push    bx
   929 000004D2 51                              push    cx
   930 000004D3 52                              push    dx
   931 000004D4 56                              push    si
