   935 000004D9 8B5E06                          mov     bx, [bp+6]          ; BX = yc
   936 000004DC 8B4E04                          mov     cx, [bp+4]          ; CX = r
   937                                  
   938                                          ; Linha vertical central: de (xc, yc - r) até (xc, yc + r)
   939 000004DF 89DE                            mov     si, bx
   940 000004E1 29CE                            sub     si, cx
   941 000004E3 50                              push    ax
   942 000004E4 56                              push    si                  ; (xc, yc - r)
   943 000004E5 89DE                            mov     si, bx
   944 000004E7 01CE                            add     si, cx
   945 000004E9 50                              push    ax
   946 000004EA 56                              push    si                  ; (xc, yc + r)
   947 000004EB E89B00                          call    line
   948                                  
   949 000004EE 89CF                            mov     di, cx
   950 000004F0 81EF0100                        sub     di, 1               ; di = r - 1
   951 000004F4 BA0000                          mov     dx, 0               ; x = 0, y = r
   952                                  
   953                                      stay_full:
   954 000004F7 89FE                            mov     si, di
   955 000004F9 81FE0000                        cmp     si, 0
   956 000004FD 7F0E                            jg      inf_full
   957                                  
   958 000004FF 89D6                            mov     si, dx
   959 00000501 D1E6                            sal     si, 1
   960 00000503 81C60300                        add     si, 3
   961 00000507 01F7                            add     di, si
   962 00000509 42                              inc     dx
   963 0000050A E90E00                          jmp     plotar_full
   964                                  
