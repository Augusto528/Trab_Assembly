   722                                      ; ROTINA: plot_xy
   723                                      ; Descrição: Desenha um ponto (pixel) na tela nas coordenadas (X, Y).
   724                                      ; Parâmetros via Pilha:
   725                                      ;   [bp+6] -> Coordenada X (0-639)
   726                                      ;   [bp+4] -> Coordenada Y (0-479)
   727                                      ; Entrada implícita: Variável 'cor'
   728                                      ; ----------------------------------------------------------------------------
   729                                      plot_xy:
   730 000003CA 55                              push    bp
   731 000003CB 89E5                            mov     bp, sp
   732 000003CD 9C                              pushf
   733 000003CE 50                              push    ax
   734 000003CF 53                              push    bx
   735 000003D0 51                              push    cx
   736 000003D1 52                              push    dx
   737 000003D2 56                              push    si
   738 000003D3 57                              push    di
   739                                  
   740 000003D4 B40C                            mov     ah, 0ch             ; Interrupção para desenhar um pixel 
   741 000003D6 A0[0000]                        mov     al, [cor]           ; Cor do pixel
   742 000003D9 B700                            mov     bh, 0               ; Página de vídeo 0
   743 000003DB 8B4E06                          mov     cx, [bp+6]          ; Coordenada X
   744 000003DE 8B5604                          mov     dx, [bp+4]          ; Coordenada Y (BIOS usa DX para Y)
   745 000003E1 CD10                            int     10h
   746                                  
   747 000003E3 5F                              pop     di
   748 000003E4 5E                              pop     si
   749 000003E5 5A                              pop     dx
   750 000003E6 59                              pop     cx
   751 000003E7 5B                              pop     bx
   752 000003E8 58                              pop     ax
   753 000003E9 9D                              popf
   754 000003EA 5D                              pop     bp
   755 000003EB C20400                          ret     4                   ; Limpa 4 bytes de parâmetros da pilha
   756                                  
   757                                      ; ----------------------------------------------------------------------------
   758                                      ; ROTINA: circle
   759                                      ; Descrição: Desenha o contorno de um círculo usando o algoritmo do Ponto Médio.
   760                                      ; Parâmetros via Pilha:
   761                                      ;   [bp+8] -> Coordenada X do centro (xc)
   762                                      ;   [bp+6] -> Coordenada Y do centro (yc)
   763                                      ;   [bp+4] -> Raio (r)
   764                                      ; ----------------------------------------------------------------------------
   765                                      circle:
   766 000003EE 55                              push    bp
   767 000003EF 89E5                            mov     bp, sp
   768 000003F1 9C                              pushf
   769 000003F2 50                              push    ax
   770 000003F3 53                              push    bx
   771 000003F4 51                              push    cx
   772 000003F5 52                              push    dx
   773 000003F6 56                              push    si
   774 000003F7 57                              push    di
   775                                  
   776 000003F8 8B4608                          mov     ax, [bp+8]          ; AX = xc
   777 000003FB 8B5E06                          mov     bx, [bp+6]          ; BX = yc
   778 000003FE 8B4E04                          mov     cx, [bp+4]          ; CX = r
   779                                  
   780                                          ; Plotagem dos 4 pontos cardeais extremos do círculo
   781 00000401 89DA                            mov     dx, bx
   782 00000403 01CA                            add     dx, cx              ; Topo: (xc, yc + r)
   783 00000405 50                              push    ax
   784 00000406 52                              push    dx
   785 00000407 E8C0FF                          call    plot_xy
   786                                  
   787 0000040A 89DA                            mov     dx, bx
   788 0000040C 29CA                            sub     dx, cx              ; Base: (xc, yc - r)
   789 0000040E 50                              push    ax
   790 0000040F 52                              push    dx
   791 00000410 E8B7FF                          call    plot_xy
   792                                  
   793 00000413 89C2                            mov     dx, ax
   794 00000415 01CA                            add     dx, cx              ; Direita: (xc + r, yc)
   795 00000417 52                              push    dx
   796 00000418 53                              push    bx
   797 00000419 E8AEFF                          call    plot_xy
   798                                  
   799 0000041C 89C2                            mov     dx, ax
   800 0000041E 29CA                            sub     dx, cx              ; Esquerda: (xc - r, yc)
   801 00000420 52                              push    dx
   802 00000421 53                              push    bx
   803 00000422 E8A5FF                          call    plot_xy
   804                                  
   805                                          ; Variáveis de decisão do algoritmo do Ponto Médio
   806 00000425 89CF                            mov     di, cx
   807 00000427 81EF0100                        sub     di, 1               ; di = d = r - 1 (variável de decisão)
   808 0000042B BA0000                          mov     dx, 0               ; DX = x = 0. CX já é a variável y = r
   809                                  
   810                                      stay:
   811 0000042E 89FE                            mov     si, di
   812 00000430 81FE0000                        cmp     si, 0
   813 00000434 7F0E                            jg      inf                 ; Se d > 0, decrementa Y (ponto inferior)
   814                                  
   815                                          ; Atualização de 'd' para o passo horizontal (E)
   816 00000436 89D6                            mov     si, dx
   817 00000438 D1E6                            sal     si, 1               ; 2 * x
   818 0000043A 81C60300                        add     si, 3               ; 2 * x + 3
   819 0000043E 01F7                            add     di, si              ; d = d + 2*x + 3
   820 00000440 42                              inc     dx                  ; x++
   821 00000441 E90E00                          jmp     plotar
   822                                  
   823                                      inf:
   824                                          ; Atualização de 'd' para o passo diagonal (SE)
   825 00000444 89D6                            mov     si, dx
   826 00000446 29CE                            sub     si, cx              ; x - y
   827 00000448 D1E6                            sal     si, 1               ; 2 * (x - y)
   828 0000044A 81C60500                        add     si, 5               ; 2 * (x - y) + 5
   829 0000044E 01F7                            add     di, si              ; d = d + 2*(x - y) + 5
   830 00000450 42                              inc     dx                  ; x++
   831 00000451 49                              dec     cx                  ; y--
   832                                  
   833                                      plotar:
   834                                          ; Plotagem simétrica nos 8 octantes:
   835 00000452 89D6                            mov     si, dx
   836 00000454 01C6                            add     si, ax
   837 00000456 56                              push    si                  ; xc + x
   838 00000457 89CE                            mov     si, cx
   839 00000459 01DE                            add     si, bx
   840 0000045B 56                              push    si                  ; yc + y
   841 0000045C E86BFF                          call    plot_xy             ; Octante 2
   842                                  
   843 0000045F 89C6                            mov     si, ax
   844 00000461 01D6                            add     si, dx
   845 00000463 56                              push    si                  ; xc + x
   846 00000464 89DE                            mov     si, bx
   847 00000466 29CE                            sub     si, cx
   848 00000468 56                              push    si                  ; yc - y
   849 00000469 E85EFF                          call    plot_xy             ; Octante 7
   850                                  
   851 0000046C 89C6                            mov     si, ax
   852 0000046E 01CE                            add     si, cx
   853 00000470 56                              push    si                  ; xc + y
   854 00000471 89DE                            mov     si, bx
   855 00000473 01D6                            add     si, dx
   856 00000475 56                              push    si                  ; yc + x
   857 00000476 E851FF                          call    plot_xy             ; Octante 1
   858                                  
   859 00000479 89C6                            mov     si, ax
   860 0000047B 01CE                            add     si, cx
   861 0000047D 56                              push    si                  ; xc + y
   862 0000047E 89DE                            mov     si, bx
   863 00000480 29D6                            sub     si, dx
   864 00000482 56                              push    si                  ; yc - x
   865 00000483 E844FF                          call    plot_xy             ; Octante 8
   866                                  
   867 00000486 89C6                            mov     si, ax
   868 00000488 29D6                            sub     si, dx
   869 0000048A 56                              push    si                  ; xc - x
   870 0000048B 89DE                            mov     si, bx
   871 0000048D 01CE                            add     si, cx
   872 0000048F 56                              push    si                  ; yc + y
   873 00000490 E837FF                          call    plot_xy             ; Octante 3
   874                                  
   875 00000493 89C6                            mov     si, ax
   876 00000495 29D6                            sub     si, dx
   877 00000497 56                              push    si                  ; xc - x
   878 00000498 89DE                            mov     si, bx
   879 0000049A 29CE                            sub     si, cx
   880 0000049C 56                              push    si                  ; yc - y
   881 0000049D E82AFF                          call    plot_xy             ; Octante 6
   882                                  
   883 000004A0 89C6                            mov     si, ax
   884 000004A2 29CE                            sub     si, cx
   885 000004A4 56                              push    si                  ; xc - y
   886 000004A5 89DE                            mov     si, bx
   887 000004A7 29D6                            sub     si, dx
   888 000004A9 56                              push    si                  ; yc - x
   889 000004AA E81DFF                          call    plot_xy             ; Octante 5
   890                                  
   891 000004AD 89C6                            mov     si, ax
   892 000004AF 29CE                            sub     si, cx
   893 000004B1 56                              push    si                  ; xc - y
   894 000004B2 89DE                            mov     si, bx
   895 000004B4 01D6                            add     si, dx
   896 000004B6 56                              push    si                  ; yc + x
   897 000004B7 E810FF                          call    plot_xy             ; Octante 4
   898                                  
   899 000004BA 39D1                            cmp     cx, dx              ; Enquanto y >= x continua no loop
   900 000004BC 7203                            jb      fim_circle
   901 000004BE E96DFF                          jmp     stay
