  1047                                      ; ----------------------------------------------------------------------------
  1048                                      ; ROTINA: line
  1049                                      ; Descrição: Desenha uma reta entre (x1, y1) e (x2, y2) utilizando
  1050                                      ;            uma variação do algoritmo de Bresenham.
  1051                                      ; Parâmetros via Pilha:
  1052                                      ;   [bp+10] -> x1
  1053                                      ;   [bp+8]  -> y1
  1054                                      ;   [bp+6]  -> x2
  1055                                      ;   [bp+4]  -> y2
  1056                                      ; ----------------------------------------------------------------------------
  1057                                      line:
  1058 00000589 55                              push    bp
  1059 0000058A 89E5                            mov     bp, sp
  1060 0000058C 9C                              pushf
  1061 0000058D 50                              push    ax
  1062 0000058E 53                              push    bx
  1063 0000058F 51                              push    cx
  1064 00000590 52                              push    dx
  1065 00000591 56                              push    si
  1066 00000592 57                              push    di
  1067                                  
  1068 00000593 8B460A                          mov     ax, [bp+10]         ; AX = x1
  1069 00000596 8B5E08                          mov     bx, [bp+8]          ; BX = y1
  1070 00000599 8B4E06                          mov     cx, [bp+6]          ; CX = x2
  1071 0000059C 8B5604                          mov     dx, [bp+4]          ; DX = y2
  1072                                  
  1073 0000059F 39C8                            cmp     ax, cx
  1074 000005A1 7408                            je      line2               ; DeltaX == 0 (Linha estritamente vertical)
  1075 000005A3 721C                            jb      line1               ; Se x1 < x2, mantém ordem
  1076 000005A5 91                              xchg    ax, cx              ; Se x1 > x2, troca os pontos para desenhar da esquerda p/ direita
  1077 000005A6 87DA                            xchg    bx, dx
  1078 000005A8 E91600                          jmp     line1
  1079                                  
  1080                                      line2:                          ; Trata linhas verticais (DeltaX = 0)
  1081 000005AB 39D3                            cmp     bx, dx
  1082 000005AD 7202                            jb      line3
  1083 000005AF 87DA                            xchg    bx, dx              ; Garante y1 < y2
  1084                                  
  1085                                      line3:                          ; Loop de desenho da linha vertical
  1086 000005B1 50                              push    ax
  1087 000005B2 53                              push    bx
